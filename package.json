{
  "name": "eventpipe-slide-presentations",
  "version": "0.1.0",
  "private": true,
  "description": "EventPipe slide design system — 1280x720 HTML slide templates, documented in Storybook, exportable to Google Slides / PowerPoint with editable layers.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build -o storybook-static",
    "dev:deck": "vite --config vite.deck.config.js --port 6009",
    "build:deck": "vite build --config vite.deck.config.js",
    "export:pptx": "node scripts/export-pptx.mjs",
    "export:png": "node scripts/export-png.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "crop:images": "node scripts/crop-images.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/poppins": "^5.1.0",
    "@mui/material": "^9.3.1",
    "@mui/x-charts": "^9.11.1",
    "material-symbols": "^0.45.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.5.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.49.0",
    "pptxgenjs": "^4.0.1",
    "storybook": "^10.4.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
