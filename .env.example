# Copy to `.env` (gitignored) and fill in. Keep this template EMPTY — it is
# tracked by git, so a real value here would be published.
#
# Unsplash — https://unsplash.com/oauth/applications
#
# ONLY the Access Key is needed. It is the public "Client-ID" used for search
# and download. The Secret Key exists solely for OAuth flows that act on a
# *user's* behalf (liking, private collections), which this repo never does —
# so do not put the secret here. It would add no capability and would be one
# more credential to rotate if it leaked.
UNSPLASH_ACCESS_KEY=

# Optional. Appended to attribution links as ?utm_source=, which the Unsplash
# API guidelines ask for. Defaults to "eventpipe_slides".
UNSPLASH_APP_NAME=eventpipe_slides
